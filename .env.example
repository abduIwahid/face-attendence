# Copy to .env.local and fill in. NEVER commit .env.local. Names only — no real values here.

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key — safe in the browser ONLY because RLS is on (see brain/SECURITY.md)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY. Bypasses RLS. Never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Default attendance radius in meters (teacher can override per class in the DB).
# Default: 100
NEXT_PUBLIC_CLASS_RADIUS_METERS=100
